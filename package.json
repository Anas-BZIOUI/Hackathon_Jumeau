{
  "name": "jumeau-numerique-ensiie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.js && node scripts/build-dungeon.mjs",
    "dev": "npm run data && concurrently \"node server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "npm run data && vite build",
    "start": "node server/index.js",
    "data:rdc": "python scripts/build-rdc.py",
    "test:rdc": "node scripts/test-authored-rdc.mjs",
    "test:campus": "node scripts/test-campus.mjs",
    "test:campus:browser": "node scripts/test-campus-browser.mjs",
    "data:dungeon": "node scripts/build-dungeon.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1",
    "vite": "^6.0.7"
  }
}
